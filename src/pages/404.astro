---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" background="/images/404_background.jpg">
  <div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <h1 class="bg-gradient-to-r from-primary-light to-secondary bg-clip-text text-8xl font-extrabold text-transparent sm:text-9xl">404</h1>
    <div class="my-6 h-px w-64 bg-white/20"></div>
    <p class="text-2xl text-slate-200">Page not found</p>
    <a href="/" class="mt-8 rounded-xl bg-primary px-6 py-3 font-semibold transition hover:bg-primary-light">Back to home</a>
  </div>
</Layout>
