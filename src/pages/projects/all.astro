---
import PageTitle from '../../components/PageTitle.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import projects from '../../data/projects.json';
import type { Project } from '../../data/types';
import Layout from '../../layouts/Layout.astro';

const list = projects as Project[];
---

<Layout
  title="Projects in detail"
  description="All projects made by Maxime Clément revolving around the Internet of Things (IoT), in detail."
  keywords="Full-stack, frontend, backend, hardware, firmware, deployment"
  background="/images/projects/background.jpg"
>
  <PageTitle eyebrow="Portfolio" title="Projects in detail" />
  <div class="mx-auto flex max-w-3xl flex-col gap-8">
    {list.map((p, i) => (
      <ProjectDetail project={p} id={i} link />
    ))}
  </div>
</Layout>
