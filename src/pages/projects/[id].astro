---
import Layout from '../../layouts/Layout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import projects from '../../data/projects.json';
import type { Project } from '../../data/types';

export function getStaticPaths() {
  const list = projects as Project[];
  return list.map((project, i) => ({ params: { id: String(i) }, props: { project, i, total: list.length } }));
}
const { project, i, total } = Astro.props;
const prev = i > 0 ? i - 1 : null;
const next = i < total - 1 ? i + 1 : null;
const list = projects as Project[];
---
<Layout title={project.title} description={project.shortSummary} keywords={project.tags.join(', ')} background="/images/projects/background.jpg" image={project.mainPictures[0].path}>
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <a href="/projects/" class="inline-flex items-center gap-2 text-sm text-slate-300 hover:text-secondary"><ArrowLeft class="size-4" /> All projects</a>
    <ProjectDetail project={project} id={i} />
    <nav class="flex justify-between gap-4 text-sm" aria-label="Project navigation">
      {prev !== null ? <a href={`/projects/${prev}/`} class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-bg-paper/60 px-4 py-3 transition hover:border-secondary/60"><ArrowLeft class="size-4" />{list[prev].title}</a> : <span />}
      {next !== null ? <a href={`/projects/${next}/`} class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-bg-paper/60 px-4 py-3 transition hover:border-secondary/60">{list[next].title}<ArrowRight class="size-4" /></a> : <span />}
    </nav>
  </div>
</Layout>
