---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Cpu from '@lucide/astro/icons/cpu';
import Database from '@lucide/astro/icons/database';
import Card from '../components/Card.astro';
import Hl from '../components/Hl.astro';
import projects from '../data/projects.json';
import { SITE } from '../data/site';
import Layout from '../layouts/Layout.astro';

const dataYears = new Date().getFullYear() - 2022;
const stats = [
  { value: '8', label: 'Years in IoT' },
  { value: `${dataYears}+`, label: 'Years in data engineering' },
  { value: String(projects.length), label: 'Projects documented' },
  { value: '4', label: 'Countries: France, Sweden, Qatar & Luxembourg' },
];
const langs = ['Go', 'PostgreSQL', 'MongoDB', 'Spanner', 'BigQuery', 'TypeScript', 'Python'];
const dataStack = [
  ['Go', 'for most backend services'],
  ['TypeScript with NestJS', 'for the other ones'],
  ['PostgreSQL and MongoDB', 'for operational data'],
  ['Spanner and BigQuery', 'when data gets bigger or needs analytics'],
  ['Python', 'for scripting and data processing'],
];
const iotStack = [
  ['C', 'for firmware'],
  ['Altium (or Eagle)', 'for PCB design'],
  ['Go or TypeScript on AWS', 'for the cloud backend'],
  ['React and Flutter', 'for web and mobile apps'],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: 'Data Engineer',
  url: SITE.url,
  sameAs: Object.values(SITE.socials),
};
const link = 'font-semibold text-secondary underline underline-offset-4 hover:text-secondary-light';
---

<Layout keywords="Portfolio, Home, Data Engineering, Backend, Go, Databases, IoT" jsonLd={jsonLd}>
  <div class="mx-auto flex max-w-5xl flex-col gap-16">
    <!-- Hero -->
    <section class="grid items-center gap-10 pt-4 lg:grid-cols-[1.25fr_1fr]">
      <div class="order-2 text-center lg:order-1 lg:text-left">
        <p class="animate-fade-up mb-5 inline-flex items-center gap-2 rounded-full border border-secondary/40 bg-secondary/10 px-4 py-1.5 text-sm font-medium text-secondary">
          <span class="size-2 animate-pulse rounded-full bg-secondary"></span> Bonjour ! Maxime
          here, Data Engineer
        </p>
        <h1 class="animate-fade-up text-4xl font-bold leading-[1.1] tracking-tight [animation-delay:80ms] sm:text-5xl xl:text-6xl">
          I build the backends that{' '}
          <span class="bg-gradient-to-r from-primary-light to-secondary bg-clip-text text-transparent">
            store and process data
          </span>
          .
        </h1>
        <p class="animate-fade-up mx-auto mt-6 max-w-xl text-lg text-slate-300 [animation-delay:160ms] lg:mx-0">
          Datalakes, microservices and databases, mostly in <b class="text-secondary">Go</b>. Before
          that, 8 years of <b class="text-secondary">IoT</b>, from PCB to cloud.
        </p>
        <div class="animate-fade-up mt-8 flex flex-wrap justify-center gap-4 [animation-delay:240ms] lg:justify-start">
          <a
            href="/skills/"
            data-magnetic
            class="group inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-on-primary shadow-lg shadow-primary/30 hover:bg-primary-light"
          >
            See my skills <ArrowRight class="size-5 transition group-hover:translate-x-1" />
          </a>
          <a
            href="/contact/"
            data-magnetic
            class="inline-flex items-center rounded-xl border border-secondary/60 px-6 py-3 font-semibold text-secondary hover:bg-secondary/10"
          >
            Get in touch
          </a>
        </div>
        <ul
          class="mt-8 flex flex-wrap justify-center gap-2 lg:justify-start"
          aria-label="Main technologies"
        >
          {langs.map((l) => (
            <li class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-slate-300 ring-1 ring-white/10">
              {l}
            </li>
          ))}
        </ul>
      </div>
      <div class="order-1 flex justify-center lg:order-2">
        <div class="animate-floaty relative">
          <div
            class="absolute -inset-6 rounded-full bg-gradient-to-tr from-primary/40 to-secondary/30 blur-3xl"
            aria-hidden="true"
          ></div>
          <img
            src="/images/home/max_pict.jpg"
            alt="Maxime Clément, Data Engineer"
            width="320"
            height="320"
            fetchpriority="high"
            class="animate-pulse-glow relative size-56 rounded-full object-cover ring-2 ring-secondary/60 sm:size-72 lg:size-80"
          />
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section aria-label="Key figures" class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {stats.map((s, i) => (
        <Card tone="neutral" delay={i * 80} class="p-5 text-center">
          <p class="bg-gradient-to-r from-primary-light to-secondary bg-clip-text font-display text-4xl font-bold text-transparent">
            {s.value}
          </p>
          <p class="mt-1 text-xs text-slate-400">{s.label}</p>
        </Card>
      ))}
    </section>

    <!-- Two chapters -->
    <section aria-labelledby="chapters-title">
      <h2 id="chapters-title" class="mb-2 text-center text-3xl font-bold">
        From IoT to data
      </h2>
      <p class="mx-auto mb-10 max-w-xl text-center text-slate-300">
        8 years on connected devices, then I moved to data engineering in 2022.
      </p>
      <div class="grid gap-6 lg:grid-cols-2">
        <Card tone="primary" class="p-6 sm:p-8">
          <p class="mb-2 inline-flex items-center gap-2 text-sm font-semibold text-secondary">
            <Database class="size-4" /> 2022 – today
          </p>
          <h3 class="mb-4 text-2xl font-bold">Now: data engineering</h3>
          <p class="text-slate-300">
            Most of my IoT projects ended with data landing in a cloud backend. Since 2022, that
            part is my full-time job: a <Hl>datalake</Hl>, with <Hl>data processing</Hl> pipeline
            feeding it, <Hl>microservices</Hl> and <Hl>databases</Hl> around it. It's operational
            scale is medium, which mean picking the right database matters more than picking the
            trendy one.
          </p>
          <ul class="mt-6 space-y-2.5">
            {dataStack.map(([name, desc]) => (
              <li class="flex gap-2 text-slate-300">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-secondary"></span>
                <span>
                  <Hl>{name}</Hl> {desc}
                </span>
              </li>
            ))}
          </ul>
        </Card>
        <Card tone="secondary" class="p-6 sm:p-8">
          <p class="mb-2 inline-flex items-center gap-2 text-sm font-semibold text-secondary">
            <Cpu class="size-4" /> 2014 – 2022
          </p>
          <h3 class="mb-4 text-2xl font-bold">Before: IoT engineering</h3>
          <p class="text-slate-300">
            For 8 years I mixed <Hl>web technologies</Hl>, <Hl>software</Hl> and <Hl>hardware</Hl>.
            Most projects combined <Hl>cloud applications</Hl> and <Hl>physical devices</Hl>, and I
            built the whole chain:
          </p>
          <ul class="mt-6 space-y-2.5">
            {iotStack.map(([name, desc]) => (
              <li class="flex gap-2 text-slate-300">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-secondary"></span>
                <span>
                  <Hl>{name}</Hl> {desc}
                </span>
              </li>
            ))}
          </ul>
          <img
            src="/images/home/iot_diagram.jpg"
            alt="IoT system diagram"
            loading="lazy"
            decoding="async"
            width="900"
            height="400"
            class="mt-6 max-h-48 w-full rounded-xl object-cover ring-1 ring-white/10"
          />
          <p class="mt-4 text-sm text-slate-400">
            The{' '}
            <a class={link} href="/projects/">
              Projects
            </a>{' '}
            page comes from that period as most where open-sourced.
          </p>
        </Card>
      </div>
    </section>

    <!-- How I work -->
    <Card tone="secondary" class="p-6 sm:p-8">
      <h2 class="mb-4 text-2xl font-bold">How I work</h2>
      <p class="text-slate-300">
        I try as much as I can to <Hl>pick the most appropriate tool for the job</Hl>, and these
        days AI is part my toolbox. I use it daily. Still, I keep doing{' '}
        <a class={link} href={SITE.socials.codewars} target="_blank" rel="noopener noreferrer">
          coding exercises
        </a>{' '}
        by hand, without help, to <Hl>keep my brain sharp</Hl>. Reviewing generated code is a lot
        easier when you can still write it yourself.
      </p>
      <p class="mt-4 text-slate-300">
        More details on what I use in the{' '}
        <a class={link} href="/skills/">
          Skills
        </a>{' '}
        section, and where I used it on the{' '}
        <a class={link} href="/path/">
          Career
        </a>{' '}
        page.
      </p>
    </Card>

    <!-- CTA -->
    <Card tone="primary" class="overflow-hidden p-10 text-center">
      <h2 class="text-2xl font-bold sm:text-3xl">Let's have a chat.</h2>
      <p class="mx-auto mt-3 max-w-lg text-slate-300">
        Data pipelines, Go, databases or IoT, I am always happy to discuss them. Reach out if you
        want to.
      </p>
      <a
        href="/contact/"
        data-magnetic
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-on-primary shadow-lg shadow-primary/30 hover:bg-primary-light"
      >
        Reach out <ArrowRight class="size-5" />
      </a>
    </Card>
  </div>
</Layout>
