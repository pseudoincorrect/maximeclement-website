---
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/PageTitle.astro';
import Card from '../components/Card.astro';
import Carousel from '../components/Carousel.astro';
const images = [
  { path: '/images/leisures/guitar.jpg', alt: 'Guitar' },
  { path: '/images/leisures/MTB.jpg', alt: 'Mountain biking' },
  { path: '/images/leisures/travelling.jpg', alt: 'Travelling' },
  { path: '/images/leisures/reading.jpg', alt: 'Reading' },
  { path: '/images/leisures/healthy.jpeg', alt: 'Healthy living' },
  { path: '/images/leisures/hangout.jpg', alt: 'Hanging out with friends' },
];
---
<Layout title="Outside Work" description="What Maxime Clément does outside work." keywords="Leisure, sport, holidays, lifestyle, music" background="/images/leisures/background.jpg">
  <PageTitle eyebrow="Off the clock" title="Let the images speak" subtitle="Music, biking, travelling, reading and good company." />
  <Card tone="secondary" class="mx-auto max-w-2xl p-4 sm:p-6">
    <Carousel images={images} height="h-72 sm:h-96" />
  </Card>
</Layout>
