---
import Card from '../components/Card.astro';
import PageTitle from '../components/PageTitle.astro';
import ToolTimeline from '../components/ToolTimeline.astro';
import Layout from '../layouts/Layout.astro';

const START = 2014;
const SWITCH = 2022;
const dataYears = new Date().getFullYear() - SWITCH;
const iotYears = SWITCH - START;

const core = [
  { tools: ['Go'], role: 'most services' },
  { tools: ['Postgres', 'MongoDB', 'Neo4j'], role: 'operational data' },
  { tools: ['Spanner', 'BigQuery'], role: 'bigger data and analytics' },
  { tools: ['Python', 'TypeScript'], role: 'scripts and NestJS services' },
  { tools: ['Docker', 'K8s'], role: 'running all of it' },
];
const alsoData = [
  'DuckDB',
  'StarRocks',
  'Iceberg',
  'PostGIS',
  'STAC',
  'OpenTelemetry',
  'SQL',
  'NestJS',
  'REST',
  'gRPC',
  'GCP',
  'GitLab',
  'GitHub',
  'Jira',
];
const workOn = ['Datalake', 'Data processing pipelines', 'Microservices', 'Data modeling'];

const timeline = [
  { name: 'Spanner', from: 2024 },
  { name: 'BigQuery', from: 2024 },
  { name: 'PostgreSQL', from: 2022 },
  { name: 'MongoDB', from: 2022 },
  { name: 'Go', from: 2019 },
  { name: 'Dart / Flutter', from: 2019, to: 2022 },
  { name: 'AWS / CDK', from: 2018, to: 2022 },
  { name: 'TypeScript', from: 2016 },
  { name: 'Python', from: 2014 },
  { name: 'C', from: 2014, to: 2022 },
];

const iot = [
  ['Firmware', 'C on Nordic, ST, ESP32, TI and Murata microcontrollers'],
  ['Wireless', 'BLE, Wi-Fi, LoRaWAN, Thread, low-power design'],
  ['Hardware', 'PCB design (Altium, Eagle), CAD (Fusion 360, SolidWorks)'],
  ['Cloud and apps', 'AWS serverless (CDK), DynamoDB, React, Flutter'],
];
const shared = [
  ['Projects', 'managed several, with budgets, Kanban and reports'],
  ['Teaching', 'designed and taught 2 hardware lab classes. Enjoy presenting!'],
  ['Teamwork', "comfortable in a team, code reviews. Well... I don't like to eat alone"],
  ['Everyday tools', 'Git, Linux and macOS, Neovim, a terminal'],
];
const heading = 'mb-4 text-xl font-bold';
---

<Layout
  title="Skills"
  description="Skills of Maxime Clément, in data engineering and IoT engineering."
  keywords="Data engineering, Go, PostgreSQL, MongoDB, Spanner, BigQuery, IoT, embedded systems"
  background="/images/skills/background.jpg"
>
  <PageTitle
    eyebrow="Expertise"
    title="Skills"
    subtitle="What I use now, what I used before."
  />
  <div class="mx-auto flex max-w-5xl flex-col gap-6">
    <!-- Time split -->
    <section aria-label="Time split between IoT and data engineering">
      <div class="flex h-4 items-center gap-0.5">
        <span class="h-4 rounded-[4px] bg-chart-data" style={`flex:${dataYears}`}></span>
        <span class="h-2 rounded-[4px] bg-chart-iot opacity-50" style={`flex:${iotYears}`}></span>
      </div>
      <div class="mt-2 flex items-start justify-between gap-4">
        <p class="flex items-start gap-2">
          <span class="mt-2 size-2.5 shrink-0 rounded-sm bg-chart-data"></span>
          <span class="flex flex-col sm:flex-row sm:items-baseline sm:gap-1.5">
            <b class="text-base sm:text-lg">Data engineering</b>
            <span class="text-sm text-slate-300">{dataYears}+ years, today</span>
          </span>
        </p>
        <p class="flex items-start gap-2 text-right text-sm text-slate-400">
          <span class="mt-1.5 size-2.5 shrink-0 rounded-sm bg-chart-iot opacity-50"></span>
          <span class="flex flex-col sm:flex-row sm:gap-1.5">
            <span class="font-semibold">IoT engineering</span> <span>{iotYears} years, before</span>
          </span>
        </p>
      </div>
    </section>

    <!-- Core tools -->
    <Card tone="primary" class="p-6">
      <h2 class={heading}>Every day</h2>
      <ul class="grid grid-cols-2 gap-3 lg:grid-cols-5">
        {core.map((c) => (
          <li class="rounded-xl border-l-4 border-chart-data bg-white/5 px-4 py-3 first:col-span-2 lg:first:col-span-1">
            {c.tools.map((t) => (
              <span class="block font-display text-lg font-bold leading-snug">{t}</span>
            ))}
            <span class="text-xs text-slate-400">{c.role}</span>
          </li>
        ))}
      </ul>
      <dl class="mt-5 space-y-1.5 text-sm">
        <div>
          <dt class="inline font-semibold text-secondary">Working on:</dt>
          <dd class="ml-1 inline text-slate-300">{workOn.join(' · ')}</dd>
        </div>
        <div>
          <dt class="inline font-semibold text-secondary">Also:</dt>
          <dd class="ml-1 inline text-slate-300">{alsoData.join(' · ')}</dd>
        </div>
      </dl>
    </Card>

    <!-- Timeline -->
    <Card tone="neutral" class="p-6">
      <h2 class="mb-1 text-xl font-bold">Over the years</h2>
      <p class="mb-5 text-sm text-slate-400">The dashed line is the move from IoT to data.</p>
      <ToolTimeline tools={timeline} start={START} switchYear={SWITCH} />
    </Card>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- IoT, kept short -->
      <Card tone="secondary" class="p-6">
        <h2 class={heading}>
          Before: IoT{' '}
          <span class="text-sm font-normal text-slate-400">
            {START} – {SWITCH}
          </span>
        </h2>
        <dl class="space-y-2 text-sm">
          {iot.map(([k, v]) => (
            <div>
              <dt class="inline font-semibold text-chart-iot">{k}:</dt>
              <dd class="ml-1 inline text-slate-300">{v}</dd>
            </div>
          ))}
        </dl>
      </Card>
      <!-- Shared -->
      <Card tone="neutral" class="p-6">
        <h2 class={heading}>Whatever the field</h2>
        <dl class="space-y-2 text-sm">
          {shared.map(([k, v]) => (
            <div>
              <dt class="inline font-semibold text-accent">{k}:</dt>
              <dd class="ml-1 inline text-slate-300">{v}</dd>
            </div>
          ))}
        </dl>
      </Card>
    </div>
  </div>
</Layout>
