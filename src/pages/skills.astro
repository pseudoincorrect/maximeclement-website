---
import Cpu from '@lucide/astro/icons/cpu';
import Database from '@lucide/astro/icons/database';
import Card from '../components/Card.astro';
import PageTitle from '../components/PageTitle.astro';
import Layout from '../layouts/Layout.astro';

type Group = { title: string; items: string[] };
const data: Group[] = [
  { title: 'Languages', items: ['Go', 'TypeScript', 'Python', 'SQL'] },
  {
    title: 'Databases',
    items: ['PostgreSQL', 'MongoDB', 'Spanner', 'BigQuery'],
  },
  {
    title: 'Architecture',
    items: ['Datalake', 'Data processing pipelines', 'Microservices'],
  },
  { title: 'Frameworks and APIs', items: ['NestJS', 'REST', 'gRPC'] },
  { title: 'Cloud and infrastructure', items: ['GCP', 'Docker', 'CI/CD'] },
];
const iot: Group[] = [
  { title: 'Languages', items: ['C', 'TypeScript', 'Go', 'Python', 'Dart', 'Bash'] },
  {
    title: 'Cloud',
    items: [
      'AWS serverless with the CDK',
      'DynamoDB',
      'Time-series databases (InfluxDB, Timestream)',
      'GitLab CI, AWS CodePipeline',
    ],
  },
  {
    title: 'Web and mobile',
    items: ['React / Next.js / Astro', 'Flutter', 'Angular (less often)'],
  },
  {
    title: 'Microcontrollers and boards',
    items: [
      'Nordic Semiconductor (Bluetooth, Thread)',
      'ST Microelectronics',
      'STM/Murata (LoRaWAN)',
      'ESP32 and Texas Instruments (Wi-Fi)',
      'Raspberry Pi, Odroid',
      'Intel FPGA + Quartus',
    ],
  },
  {
    title: 'Firmware',
    items: [
      'Wireless protocols (BLE, Wi-Fi, LoRaWAN, Thread)',
      'Low-power and ultra-low-power',
      'Digital signal processing',
      'Ceedling (Unity + CMock)',
      'Keil, Segger, Code Composer Studio',
    ],
  },
  {
    title: 'Hardware',
    items: ['PCB design: Altium, Eagle', 'CAD: Fusion 360, SolidWorks', 'Prototyping'],
  },
];
const shared: Group[] = [
  {
    title: 'Project Management',
    items: [
      'Managed multiple projects',
      'Budget analysis for each of them',
      'Kanban methods similar to Agile ones',
      'Report writing',
    ],
  },
  {
    title: 'Instructing',
    items: [
      'Designed and taught 2 hardware classes (laboratories)',
      'Instructed researchers/students on projects within my area of expertise',
      'Enjoy presenting!',
    ],
  },
  {
    title: 'Teamwork',
    items: ['Comfortable working in a team', 'Code reviews', "Well... I don't like to eat alone"],
  },
  {
    title: 'Everyday tools',
    items: ['Git', 'Linux and macOS', 'Neovim', 'Comfortable with a terminal'],
  },
];
const columns = [
  {
    icon: Database,
    title: 'Data engineering',
    dates: '2022 – today',
    note: 'What I work with every day.',
    groups: data,
    tone: 'primary' as const,
  },
  {
    icon: Cpu,
    title: 'IoT engineering',
    dates: '2014 – 2022',
    note: 'What I used to build connected devices, end to end.',
    groups: iot,
    tone: 'secondary' as const,
  },
];
const chip =
  'rounded-lg bg-white/5 px-3 py-1.5 text-sm text-slate-200 ring-1 ring-white/10 transition hover:bg-secondary/10 hover:ring-secondary/50';
---

<Layout
  title="Skills"
  description="Skills of Maxime Clément, in data engineering and IoT engineering."
  keywords="Data engineering, Go, PostgreSQL, MongoDB, Spanner, BigQuery, IoT, embedded systems"
  background="/images/skills/background.jpg"
>
  <PageTitle
    eyebrow="Expertise"
    title="Skills"
    subtitle="Two sets: the data engineering I do now, and the IoT engineering I did before."
  />
  <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-2">
    {columns.map((c) => (
      <Card tone={c.tone} class="p-6">
        <header class="mb-5 border-b border-white/10 pb-4">
          <p class="mb-1 inline-flex items-center gap-2 text-sm font-semibold text-secondary">
            <c.icon class="size-4" /> {c.dates}
          </p>
          <h2 class="text-2xl font-bold">{c.title}</h2>
          <p class="mt-1 text-sm text-slate-400">{c.note}</p>
        </header>
        <div class="space-y-5">
          {c.groups.map((g) => (
            <section>
              <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-accent">
                {g.title}
              </h3>
              <ul class="flex flex-wrap gap-2">
                {g.items.map((it) => (
                  <li class={chip}>{it}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </Card>
    ))}
    <Card tone="neutral" class="p-6 lg:col-span-2">
      <h2 class="mb-5 border-b border-white/10 pb-4 text-2xl font-bold">Whatever the field</h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {shared.map((g) => (
          <section>
            <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-accent">
              {g.title}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {g.items.map((it) => (
                <li class={chip}>{it}</li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </Card>
  </div>
</Layout>
