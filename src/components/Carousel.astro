---
import ChevronLeft from '@lucide/astro/icons/arrow-left';
import ChevronRight from '@lucide/astro/icons/arrow-right';
import type { Picture } from '../data/types';
interface Props { images: Picture[]; height?: string }
const { images, height = 'h-64 sm:h-80' } = Astro.props;
---
<div class="carousel relative" data-carousel>
  <div class:list={['flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden rounded-xl bg-black/30', height]} data-track tabindex="0" role="region" aria-label="Image gallery">
    {images.map((img, i) => (
      <div class="size-full shrink-0 snap-center">
        <img src={img.path} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} class="size-full object-contain" />
      </div>
    ))}
  </div>
  {images.length > 1 && (
    <>
      <button type="button" data-prev aria-label="Previous image" class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-black/60 p-2 text-white backdrop-blur transition hover:bg-primary"><ChevronLeft class="size-5" /></button>
      <button type="button" data-next aria-label="Next image" class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-black/60 p-2 text-white backdrop-blur transition hover:bg-primary"><ChevronRight class="size-5" /></button>
      <div class="mt-3 flex flex-wrap justify-center gap-1.5" data-dots>
        {images.map((_, i) => <button type="button" aria-label={`Go to image ${i + 1}`} data-dot={i} class="size-2 rounded-full bg-white/30 transition aria-[current=true]:w-5 aria-[current=true]:bg-secondary"></button>)}
      </div>
    </>
  )}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
    const count = track.children.length;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + count) % count) * track.clientWidth, behavior: 'smooth' });
    const sync = () => dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index())));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index() - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index() + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(index() - 1);
      if (e.key === 'ArrowRight') go(index() + 1);
    });
    sync();
  });
</script>
