---
import Card from './Card.astro';
import Carousel from './Carousel.astro';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import MapPin from '@lucide/astro/icons/map-pin';
import Calendar from '@lucide/astro/icons/calendar';
import { categoriesOf } from '../data/categories';
import type { Project } from '../data/types';
interface Props { project: Project; id: number; link?: boolean }
const { project, id, link = false } = Astro.props;
const cats = categoriesOf(project);
---
<Card tone="primary" as="article" class="w-full scroll-mt-24 overflow-hidden p-5 sm:p-7">
  <h2 id={`project-${id}`} class="mb-5 scroll-mt-24 text-center text-3xl font-bold">
    {link ? <a href={`/projects/${id}/`} class="hover:text-secondary">{project.title}</a> : project.title}
  </h2>
  <div class="mb-5 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-300">
    <span class="inline-flex items-center gap-1.5"><MapPin class="size-4 text-secondary" />{project.location.trim()}</span>
    <span class="inline-flex items-center gap-1.5"><Calendar class="size-4 text-secondary" />{project.date}</span>
  </div>
  <Carousel images={project.mainPictures} />
  <section id={`overview-${id}`} class="rich-content mt-6 scroll-mt-24" set:html={project.summary} />
  <details id={`details-${id}`} class="group mt-6 scroll-mt-24 rounded-xl border border-secondary/20 bg-secondary/5">
    <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-3 font-display text-lg font-semibold [&::-webkit-details-marker]:hidden">
      More details <ChevronDown class="size-5 transition group-open:rotate-180" />
    </summary>
    <div class="rich-content border-t border-white/10 px-5 py-4" set:html={project.details} />
  </details>
  <ul class="mt-5 flex flex-wrap gap-2">
    {cats.map((c) => <li class="rounded-full bg-secondary/15 px-3 py-1 text-xs font-semibold text-secondary ring-1 ring-secondary/40">{c}</li>)}
    {project.tags.map((t) => <li class="rounded-full bg-primary/20 px-3 py-1 text-xs font-medium text-slate-200 ring-1 ring-primary/40">{t}</li>)}
  </ul>
</Card>
