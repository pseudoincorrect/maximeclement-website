---
interface Props {
  tone?: 'primary' | 'secondary' | 'neutral';
  class?: string;
  as?: string;
  reveal?: boolean;
  delay?: number;
}
const {
  tone = 'primary',
  class: cls = '',
  as: tag = 'div',
  reveal = true,
  delay = 0,
} = Astro.props;
const Tag: any = tag;
const tones = {
  primary: 'border-primary/40 hover:border-primary/80 shadow-primary/10',
  secondary: 'border-secondary/35 hover:border-secondary/70 shadow-secondary/10',
  neutral: 'border-white/10 hover:border-white/25 shadow-black/20',
};
---

<Tag
  data-reveal={reveal ? '' : undefined}
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
  class:list={[
    'rounded-2xl border bg-bg-paper/60 backdrop-blur-md shadow-xl transition-colors duration-300',
    tones[tone],
    cls,
  ]}
>
  <slot />
</Tag>
