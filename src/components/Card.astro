---
interface Props { tone?: 'primary' | 'secondary' | 'neutral'; class?: string; as?: string }
const { tone = 'primary', class: cls = '', as: Tag = 'div' } = Astro.props;
const tones = {
  primary: 'border-primary/50 hover:border-primary/80 shadow-primary/10',
  secondary: 'border-secondary/40 hover:border-secondary/70 shadow-secondary/10',
  neutral: 'border-white/10 hover:border-white/25 shadow-black/20',
};
---
<Tag class:list={['rounded-2xl border bg-bg-paper/60 backdrop-blur-md shadow-xl transition-colors duration-300', tones[tone], cls]}>
  <slot />
</Tag>
