---
interface Props { title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
---
<header class="mx-auto mb-10 max-w-3xl text-center animate-fade-up">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    <span class="bg-gradient-to-r from-primary-light via-secondary to-secondary-light bg-clip-text text-transparent">{title}</span>
  </h1>
  {subtitle && <p class="mt-4 text-lg text-slate-300">{subtitle}</p>}
</header>
