---
import { categoriesOf, FEATURED } from '../data/categories';
import type { Project } from '../data/types';
import Card from './Card.astro';

interface Props {
  project: Project;
  id: number;
  eager?: boolean;
  delay?: number;
}
const { project: p, id, eager = false, delay = 0 } = Astro.props;
const featured = FEATURED.has(p.title);
const cats = categoriesOf(p);
---

<a
  href={`/projects/${id}/`}
  data-categories={cats.join('|')}
  class:list={['group block', featured && 'md:col-span-2']}
>
  <Card
    tone="neutral"
    delay={delay}
    class:list={[
      'flex h-full flex-col overflow-hidden transition duration-300 group-hover:-translate-y-1 group-hover:border-secondary/60 group-hover:shadow-secondary/20',
      featured && 'md:flex-row',
    ]}
  >
    <div
      class:list={[
        'overflow-hidden bg-black/40',
        featured ? 'aspect-[16/9] md:aspect-auto md:w-1/2' : 'aspect-[16/9]',
      ]}
    >
      <img
        src={p.mainPictures[0].path}
        alt={p.mainPictures[0].alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="size-full object-cover transition duration-500 group-hover:scale-105"
      />
    </div>
    <div class:list={['flex flex-1 flex-col p-5', featured && 'md:w-1/2 md:p-7']}>
      {featured && (
        <span class="mb-2 w-fit rounded-full bg-accent/15 px-2.5 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wider text-accent ring-1 ring-accent/40">
          Featured
        </span>
      )}
      <h2 class:list={['mb-1 font-bold text-accent', featured ? 'text-2xl' : 'text-xl']}>
        {p.title}
      </h2>
      <p class="mb-3 text-xs text-slate-400">{p.date}</p>
      <p class="flex-1 text-sm leading-relaxed text-slate-300">{p.shortSummary}</p>
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {cats.slice(0, 3).map((t) => (
          <li class="rounded-full bg-primary/20 px-2.5 py-0.5 text-[0.7rem] text-slate-200 ring-1 ring-primary/40">
            {t}
          </li>
        ))}
      </ul>
    </div>
  </Card>
</a>
